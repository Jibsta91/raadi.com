{
  "$id": "urn:raadi:event:no.raadi.identity.user.preferences_changed.v1",
  "title": "no.raadi.identity.user.preferences_changed.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locale": {
      "type": "string",
      "enum": ["nb", "en", "so"]
    }
  },
  "required": ["userId", "changed"],
  "additionalProperties": false
}
