{
  "name": "@raadi/catalog",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Marketplace taxonomy (categories, attributes), Norwegian places for geo search, and the deterministic demo dataset.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "default": "./dist/demo.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec '.build/test/**/*.test.js'"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@raadi/config": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3"
  }
}
